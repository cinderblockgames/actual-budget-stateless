@model AccountsViewModel

@{
    ViewData["Title"] = "Accounts";
}

<div class="text-center">
    <h1 class="display-6">Accounts</h1>
    <table class="table table-striped table-bordered">
        <thead>
        <tr class="table-primary" data-href="@Url.ActionLink("All", "Transactions")">
            <th scope="col">All accounts</th>
            <th scope="col">@Model.AllAccountsTotal</th>
        </tr>
        </thead>
        
        <tbody>
        @if (Model.OnBudgetAccounts.Any())
        {
            <tr class="table-info" data-href="@Url.ActionLink("OnBudget", "Transactions")">
                <th scope="col">On budget</th>
                <th scope="col">@Model.OnBudgetAccountsTotal</th>
            </tr>

            @foreach (var account in Model.OnBudgetAccounts)
            {
                <tr data-href="@Url.ActionLink("Account", "Transactions", new { accountId = account.Id })">
                    <td>@account.Name</td>
                    <td>@account.WorkingBalance</td>
                </tr>
            }
        }
        
        @if (Model.OffBudgetAccounts.Any())
        {
            <tr class="table-info" data-href="@Url.ActionLink("OffBudget", "Transactions")">
                <th scope="col">Off budget</th>
                <th scope="col">@Model.OffBudgetAccountsTotal</th>
            </tr>

            @foreach (var account in Model.OffBudgetAccounts)
            {
                <tr data-href="@Url.ActionLink("Account", "Transactions", new { accountId = account.Id })">
                    <td>@account.Name</td>
                    <td>@account.WorkingBalance</td>
                </tr>
            }
        }

        @if (Model.ClosedAccounts.Any())
        {
            <tr class="table-info">
                <th scope="col">Closed Accounts</th>
                <th scope="col"></th>
            </tr>

            @foreach (var account in Model.ClosedAccounts)
            {
                <tr data-href="@Url.ActionLink("Account", "Transactions", new { accountId = account.Id })">
                    <td>@account.Name</td>
                    <td>@account.WorkingBalance</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>