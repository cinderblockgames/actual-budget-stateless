@model MonthInfoViewModel

@{
    ViewData["Title"] = $"{Model.Month.Display}";
}

<div class="text-center">
    <h1 class="display-6">
        @if (Model.PreviousMonth != null)
        {
            <a class="text-dark" style="text-decoration: none" href="../@Model.PreviousMonth.Year/@Model.PreviousMonth.Month">&lt;</a>
        }
        @Model.Month.Display
        @if (Model.NextMonth != null)
        {
            <a class="text-dark" style="text-decoration: none" href="../@Model.NextMonth.Year/@Model.NextMonth.Month">&gt;</a>
        }
        @if (!Model.IsCurrentMonth)
        {
            <a class="text-dark" style="text-decoration: none" href="../@DateTime.Now.Year/@DateTime.Now.Month.ToString("00")">🗓️</a>
        }
    </h1>
    <table class="table table-striped table-bordered">
        <thead>
        <tr class="table-primary">
            <th scope="col">
                @(Model.ToBudget.StartsWith("-") ? "Overbudgeted" : "To Budget")
                <span id="show-hide-hidden-categories"
                      data-toggle="tooltip"
                      title="Hide Hidden Categories">👁</span>
                <br/>
                @Model.ToBudget
            </th>
            <th scope="col">
                Budgeted
                <br/>
                @Model.TotalBudgeted
            </th>
            <th scope="col">
                Spent
                <br/>
                @Model.TotalSpent
            </th>
            <th scope="col">
                Balance
                <br/>
                @Model.TotalBalance
            </th>
        </tr>
        </thead>
        
        @foreach (var group in Model.CategoryGroups.Where(cg => !cg.Income))
        {
            var id = group.Name.Replace(' ', '-');
            
            <tr class="table-info" data-collapse="#@id" data-hidden="@group.Hidden">
                <th scope="col">@group.Name</th>
                <th scope="col">@group.Budgeted</th>
                <th scope="col">@group.Spent</th>
                <th scope="col">@group.Balance</th>
            </tr>
            
            <tbody id="@id">
            @foreach (var category in group.Categories)
            {
                <tr data-hidden="@(group.Hidden || category.Hidden)">
                    <td>
                        @category.Name
                        @if (category.ShowAutomation) {
                            <span data-toggle="tooltip" title="@category.Automation">🕒</span>
                        }
                        @if (category.ShowNotes)
                        {
                            <span data-toggle="tooltip" title="@category.Notes">📄</span>
                        }
                    </td>
                    <td>@category.Budgeted</td>
                    <td>@category.Spent</td>
                    <td>@category.Balance @(@category.Carryover ? "→" : "")</td>
                </tr>
            }
            </tbody>
        }
        
        <tr>
            <td colspan="4" style="height:40px"></td>
        </tr>
        @foreach (var group in Model.CategoryGroups.Where(cg => cg.Income))
        {
            var id = group.Name.Replace(' ', '-');
            
            <tr class="table-primary" data-collapse="#@id" data-hidden="@group.Hidden">
                <th scope="col">@group.Name</th>
                <th scope="col"></th>
                <th scope="col"></th>
                <th scope="col">@Model.TotalIncome</th>
            </tr>
            
            <tbody id="@id">
            @foreach (var category in group.Categories)
            {
                <tr data-hidden="@(group.Hidden || category.Hidden)">
                    <td>@category.Name</td>
                    <td></td>
                    <td></td>
                    <td>@category.Received</td>
                </tr>
            }
            </tbody>
        }
    </table>
</div>

@section Scripts
{
    <script type="text/javascript">
        $(function() {
            localStorage.setItem("month", "@Model.Month.Joined");

            const collapsed = (localStorage.getItem('collapsed') || '').split('|');
            $(collapsed).each((id, name) => $(name).hide());
            
            const hidden = localStorage.getItem('hidden');
            if (hidden) {
                toggler = $('#show-hide-hidden-categories');
                toggler.tooltip('dispose');
                toggler.attr('title', 'Show Hidden Categories');
                toggler.tooltip();
                $('tr[data-hidden="True"]').hide();
            }
        });

        $('[data-collapse]').on('click', function() {
            // collapse the target
            const id = $(this).data('collapse');
            $(id).toggle();

            // store for future
            const collapsed = localStorage.getItem('collapsed');
            let newCollapsed = collapsed ? collapsed.split('|') : [];
            if ($(id).is(':visible')) {
                newCollapsed = newCollapsed.filter(e => e !== id);
            } else {
                newCollapsed.push(id);
            }
            localStorage.setItem('collapsed', newCollapsed.join('|'));
        })
        
        $('#show-hide-hidden-categories').on('click', function() {
            const hidden = localStorage.getItem('hidden');
            const toggler = $('#show-hide-hidden-categories');
            if (hidden) {
                localStorage.removeItem('hidden');
                toggler.tooltip('dispose');
                toggler.attr('title', 'Hide Hidden Categories');
                toggler.tooltip();
                $('tr[data-hidden="True"]').show();
            } else {
                localStorage.setItem('hidden', true);
                toggler.tooltip('dispose');
                toggler.attr('title', 'Show Hidden Categories');
                toggler.tooltip();
                $('tr[data-hidden="True"]').hide();
            }
        });
    </script>
}
