@model MonthInfoViewModel

@{
    ViewData["Title"] = $"{Model.Month.Display}";
}

<div class="text-center">
    <h1 class="display-4">
        @if (Model.PreviousMonth != null)
        {
            <a class="text-dark" style="text-decoration: none" href="../@Model.PreviousMonth.Year/@Model.PreviousMonth.Month">&lt;</a>
        }
        @Model.Month.Display
        @if (Model.NextMonth != null)
        {
            <a class="text-dark" style="text-decoration: none" href="../@Model.NextMonth.Year/@Model.NextMonth.Month">&gt;</a>
        }
        @if (!Model.IsCurrentMonth)
        {
            <a class="text-dark" style="text-decoration: none" href="../@DateTime.Now.Year/@DateTime.Now.Month.ToString("00")">🗓️</a>
        }
    </h1>
    <table class="table table-striped table-bordered">
        <thead>
        <tr class="table-primary">
            <th scope="col">
                @(Model.ToBudget.StartsWith("-") ? "Overbudgeted" : "To Budget")
                <br/>
                @Model.ToBudget
            </th>
            <th scope="col">
                Budgeted
                <br/>
                @Model.TotalBudgeted
            </th>
            <th scope="col">
                Spent
                <br/>
                @Model.TotalSpent
            </th>
            <th scope="col">
                Balance
                <br/>
                @Model.TotalBalance
            </th>
        </tr>
        </thead>
        
        @foreach (var group in Model.CategoryGroups.Where(cg => !cg.Income))
        {
            var id = group.Name.Replace(' ', '-');
            
            <tr class="table-info" data-collapse="#@id">
                <th scope="col">@group.Name</th>
                <th scope="col">@group.Budgeted</th>
                <th scope="col">@group.Spent</th>
                <th scope="col">@group.Balance</th>
            </tr>
            
            <tbody id="@id">
            @foreach (var category in group.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Budgeted</td>
                    <td>@category.Spent</td>
                    <td>@category.Balance</td>
                </tr>
            }
            </tbody>
        }
        
        <tr>
            <td colspan="4" style="height:40px"></td>
        </tr>
        @foreach (var group in Model.CategoryGroups.Where(cg => cg.Income))
        {
            var id = group.Name.Replace(' ', '-');
            
            <tr class="table-primary" data-collapse="#@id">
                <th scope="col">@group.Name</th>
                <th scope="col"></th>
                <th scope="col"></th>
                <th scope="col">@Model.TotalIncome</th>
            </tr>
            
            <tbody id="@id">
            @foreach (var category in group.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td></td>
                    <td></td>
                    <td>@category.Received</td>
                </tr>
            }
            </tbody>
        }
    </table>
</div>

@section Scripts
{
    <script type="text/javascript">
        $(function() {
            localStorage.setItem("month", "@Model.Month.Joined");

            const collapsed = (localStorage.getItem('collapsed') || '').split('|');
            $(collapsed).each((id, name) => $(name).hide());
        });

        $('[data-collapse]').on('click', function() {
            // collapse the target
            const id = $(this).data('collapse');
            $(id).toggle();

            // store for future
            const collapsed = localStorage.getItem('collapsed');
            let newCollapsed = collapsed ? collapsed.split('|') : [];
            if ($(id).is(':visible')) {
                newCollapsed = newCollapsed.filter(e => e !== id);
            } else {
                newCollapsed.push(id);
            }
            localStorage.setItem('collapsed', newCollapsed.join('|'));
        })
    </script>
}
