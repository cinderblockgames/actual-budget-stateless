@model MonthInfoViewModel

@{
    ViewData["Title"] = $"{Model.Month} {Model.Year}";
}

<div class="text-center">
    <h1 class="display-4">@Model.Month @Model.Year</h1>
    <table class="table table-striped table-bordered">
        <thead>
        <tr class="table-primary">
            <th scope="col">Category</th>
            <th scope="col">Budgeted</th>
            <th scope="col">Spent</th>
            <th scope="col">Balance</th>
        </tr>
        </thead>
        
        <tbody>
        @foreach (var group in Model.CategoryGroups)
        {
            <tr class="table-info">
                <th scope="col">@group.Name</th>
                <th scope="col">@group.Budgeted</th>
                <th scope="col">@group.Spent</th>
                <th scope="col">@group.Balance</th>
            </tr>

            @foreach (var category in group.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Budgeted</td>
                    <td>@category.Spent</td>
                    <td>@category.Balance</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>