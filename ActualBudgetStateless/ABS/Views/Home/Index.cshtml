@{
    ViewData["Title"] = $"Actual Budget (Stateless)";
}

@section Scripts
{
    <script type="text/javascript">
        const budget = localStorage.getItem("budget");
        alert(window.location.href);
        if (!budget) {
            window.location.href = "switchbudget";
        } else {
            window.location.href = "switchbudget/setbudgetfile/" + budget;
        }
    </script>
}
