@model MonthInfoViewModel

@{
    ViewData["Title"] = $"Actual Budget (Stateless)";
}

@section Scripts
{
    <script type="text/javascript">
        var month = localStorage.getItem("month");
        if (!month)
        {
            var today = new Date();
            var mm =  String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();
            month = [yyyy, mm].join("-");
            localStorage.setItem("month", month);
        }
        window.location.href = ["budget", ...month.split("-")].join("/");
    </script>
}
