@{
    ViewData["Title"] = $"Actual Budget (Stateless)";
}

@section Scripts
{
    <script type="text/javascript">
        const budget = localStorage.getItem("budget");
        if (!budget) {
            window.location = "switchbudget";
        } else {
            window.location = "switchbudget/setbudgetfile/" + budget;
        }
    </script>
}
